datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model Review {
  id        Int      @id @default(autoincrement())
  text      String
  user      String
  sentiment String
  score     Float
  createdAt DateTime @default(now())
}